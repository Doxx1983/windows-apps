<Application x:Class="Dateiablage.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- Schlichtes Design wie Zwischenablage und Aufgaben-App: neutral, ein Akzent, Hell/Dunkel automatisch.
         Die Dunkel-Werte setzt App.xaml.cs je nach Windows-Einstellung. -->
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#F6F7F9" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Surface2" Color="#EDEFF3" />
        <SolidColorBrush x:Key="Text" Color="#1B1F27" />
        <SolidColorBrush x:Key="Muted" Color="#667085" />
        <SolidColorBrush x:Key="Line" Color="#E1E4EA" />
        <SolidColorBrush x:Key="Accent" Color="#4361EE" />
        <SolidColorBrush x:Key="AccentSoft" Color="#E7EBFD" />

        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                                BorderThickness="1" CornerRadius="6" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface2}" />
                            </Trigger>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
